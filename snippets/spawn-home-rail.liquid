{%- if rail_collection != blank and rail_collection.products_count > 0 -%}
  <section class="sh-section sh-rail-section sh-shell" aria-labelledby="{{ rail_id }}-heading">
    <div class="sh-section-head">
      <div><p class="sh-eyebrow">{{ eyebrow | escape }}</p><h2 id="{{ rail_id }}-heading">{{ heading | escape }}</h2></div>
      <div class="sh-section-head__links">
        <a href="{{ rail_collection.url }}" class="sh-text-link">{{ link_label | escape }}</a>
        {%- if library_link_label != blank -%}
          <a href="{{ pages['fly-library'].url }}" class="sh-text-link sh-text-link--quiet">{{ library_link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
    <spawn-product-rail class="sh-rail">
      <ul class="sh-product-track" id="{{ rail_id }}" tabindex="0" aria-label="{{ heading | escape }}. Scroll for more products.">
        {%- paginate rail_collection.products by 8 -%}
          {%- for product in rail_collection.products limit: 8 -%}{% render 'spawn-home-product', product: product %}{%- endfor -%}
        {%- endpaginate -%}
      </ul>
      <div class="sh-rail-controls" hidden>
        <span class="sh-rail-position" aria-live="polite"></span>
        <div><button type="button" data-direction="previous" aria-label="Previous products" aria-controls="{{ rail_id }}">←</button><button type="button" data-direction="next" aria-label="Next products" aria-controls="{{ rail_id }}">→</button></div>
      </div>
    </spawn-product-rail>
  </section>
{%- endif -%}
