{% comment %}
  Renders progress for permanent automatic offers.
  Shopify chooses the best eligible product discount when offers overlap.
{% endcomment %}

{%- liquid
  assign shank_skus = 'SHNK-9-20,SHNKVRTY-60,SHNK-9-50,SHNK-20-50,SHNKVRTY-180,SHNK60-30-20,SHNK60-40-20,SHNK90-30-20,SHNK-15-50,SHNK-19-20,SHNK90-40-20,SHNK90-20-20,SHNK-18-20,SHNK-17-20' | split: ','
  assign feather_skus = 'SPAWNWIDGEON-1,SPAWNPINTAIL-6,SPAWNWOODDUCK,SPAWNGADWALL-2,SPAWNGWT-4' | split: ','
  assign shank_quantity = 0
  assign feather_quantity = 0

  for item in cart.items
    if shank_skus contains item.sku
      assign shank_quantity = shank_quantity | plus: item.quantity
    endif
    if feather_skus contains item.sku
      assign feather_quantity = feather_quantity | plus: item.quantity
    endif
  endfor

  assign shank_remainder = shank_quantity | modulo: 2
  assign shank_progress = shank_remainder | times: 50
  assign shanks_needed = 2 | minus: shank_remainder
  if shank_quantity > 0 and shank_remainder == 0
    assign shank_progress = 100
    assign shanks_needed = 0
  endif

  assign feather_remainder = feather_quantity | modulo: 2
  assign feather_progress = feather_remainder | times: 50
  assign feathers_needed = 2 | minus: feather_remainder
  if feather_quantity > 0 and feather_remainder == 0
    assign feather_progress = 100
    assign feathers_needed = 0
  endif

-%}

<aside class="cart-promotions" aria-labelledby="CartPromotions-{{ context }}-Title">
  <h2 id="CartPromotions-{{ context }}-Title" class="cart-promotions__title">Select 2 for 1</h2>
  <div class="cart-promotions__list">
    <section class="cart-promotion{% if shank_quantity >= 2 %} cart-promotion--qualified{% endif %}" data-discount-id="1371867250751">
      <div class="cart-promotion__heading">
        <h3>Select mix shanks · 2 for 1</h3>
        {%- if shank_quantity >= 2 -%}<span>Qualified</span>{%- endif -%}
      </div>
      <p>
        {%- if shank_quantity >= 2 and shank_remainder == 0 -%}
          {{ shank_quantity }} eligible shanks · offer repeats for every pair
        {%- elsif shank_quantity >= 2 -%}
          {{ shank_quantity }} eligible shanks · add 1 for another pair
        {%- else -%}
          {{ shank_quantity }} of 2 · add {{ shanks_needed }} eligible shanks
        {%- endif -%}
      </p>
      <span class="cart-promotion__track" aria-hidden="true"><span style="--promotion-progress: {{ shank_progress }}%;"></span></span>
    </section>

    <section class="cart-promotion{% if feather_quantity >= 2 %} cart-promotion--qualified{% endif %}" data-discount-id="1371867283519">
      <div class="cart-promotion__heading">
        <h3>Select mix feathers · 2 for 1</h3>
        {%- if feather_quantity >= 2 -%}<span>Qualified</span>{%- endif -%}
      </div>
      <p>
        {%- if feather_quantity >= 2 and feather_remainder == 0 -%}
          {{ feather_quantity }} eligible feathers · offer repeats for every pair
        {%- elsif feather_quantity >= 2 -%}
          {{ feather_quantity }} eligible feathers · add 1 for another pair
        {%- else -%}
          {{ feather_quantity }} of 2 · add {{ feathers_needed }} eligible feathers
        {%- endif -%}
      </p>
      <span class="cart-promotion__track" aria-hidden="true"><span style="--promotion-progress: {{ feather_progress }}%;"></span></span>
    </section>

  </div>
  <p class="cart-promotions__note">Automatic product offers do not stack. Shopify applies the best eligible offer.</p>
</aside>
