          "type": "collapsible_row",
          "settings": {
            "heading": "How should I store feathers?",
            "icon": "none",
            "row_content": "<p>Dry, flat or loosely sleeved. Keep moths and moisture out. Crushed packs waste the tips you paid for.</p>"
