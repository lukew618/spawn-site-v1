    "howto": {
      "type": "image-with-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "How to choose",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Natural vs synthetic.</strong> Naturals (wood duck, widgeon, fur) give life and taper; synthetics and flash hold color and take a beating in steelhead and salt.</p><p><strong>Fresh vs salt / weight vs float.</strong> Trout and steelhead lean on waterfowl and tungsten; baitfish builds pull flash and larger shanks. Slotted tungsten gets nymphs down—see <a href=\"/collections/fly-tying-beads#bead-sizing\">bead sizing</a>.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "button_label": "Select feathers on sale (timed)",
            "button_link": "shopify://collections/tying-room-clearance",
            "button_style_secondary": true
          }
        }
