        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What should I buy for freshwater vs saltwater or steelhead?",
            "icon": "none",
            "row_content": "<p>Trout leans softer fiber, dubbing, lighter beads. Steelhead and salt lean stronger wire, flash, and articulated shanks that take a beating.</p>"
