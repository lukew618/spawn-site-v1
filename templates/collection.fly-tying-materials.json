        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Intruders and game-changers on <a href=\"/collections/fly-tying-shanks\">articulated shanks</a>, collars and wings from <a href=\"/products/spawn-super-select-barred-wood-duck\">barred wood duck</a> and Select waterfowl, winter nymphs with slotted tungsten. Ships from Washington nationwide. Pair a <a href=\"/products/stonfo-elite-vise\">Stonfo Elite vise</a> when you are building out the bench.</p>"
          }
        }
