    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What’s the difference between fly tying materials and supplies?",
            "icon": "none",
            "row_content": "<p>Materials go on the hook—feathers, beads, shanks, dubbing, flash. Supplies and tools (vises, scissors, adhesives) help you put them there.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What should I buy for freshwater vs saltwater or steelhead?",
            "icon": "none",
            "row_content": "<p>Freshwater trout: softer fibers, dubbing, lighter beads. Steelhead and salt: stronger wire, flash, articulated shanks, and materials that survive abrasive mouths.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where should a beginner start?",
            "icon": "none",
            "row_content": "<p>Pick a vise, then one category rail—feathers or beads—and a few Spawn Select or house SKUs before expanding the bench.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where do you ship from?",
            "icon": "none",
            "row_content": "<p>Nationwide from our Ilwaco, Washington shop.</p>"
          }
        },
        "q5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are sale items on this hub?",
            "icon": "none",
            "row_content": "<p>No. This hub is full-price. Timed Select-feather discounts live on the <a href=\"/collections/tying-room-clearance\">Labor Day Sale</a> collection.</p>"
          }
        }
      },
