{{ 'section-wholesale-landing.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign login_url = routes.account_login_url
  assign collections_url = routes.all_products_collection_url
  if section.settings.shop_link != blank
    assign collections_url = section.settings.shop_link
  endif
  assign support_email = section.settings.support_email | default: shop.email
  assign hero_alt = section.settings.hero_image.alt | default: shop.name
-%}

<div class="sw-landing">
  <section
    class="sh-home sw-hero{% if section.settings.hero_image != blank %} sw-hero--image{% endif %}"
    aria-labelledby="WholesaleTitle-{{ section.id }}"
  >
    {%- if section.settings.hero_image != blank -%}
      {{
        section.settings.hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'sw-hero__image',
          widths: '550, 750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_alt
      }}
    {%- endif -%}
    <div class="sw-hero__content sh-shell">
      <p class="sh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="WholesaleTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.lede != blank -%}
        <p class="sw-hero__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
      <div class="sh-actions">
        {%- if customer.b2b? -%}
          <a class="sh-button sh-button--accent" href="{{ collections_url }}">
            {{- section.settings.shop_label | default: 'Start ordering' | escape -}}
          </a>
          <a class="sh-button sh-button--outline" href="{{ routes.account_url }}">
            {{- section.settings.account_label | default: 'Your account' | escape -}}
          </a>
        {%- else -%}
          <a class="sh-button sh-button--accent" href="#WholesaleRequest">
            {{- section.settings.request_label | default: 'Request wholesale access' | escape -}}
          </a>
          <a class="sh-button sh-button--outline" href="{{ login_url }}">
            {{- section.settings.login_label | default: 'Dealer sign in' | escape -}}
          </a>
        {%- endif -%}
      </div>
      {%- if customer.b2b? -%}
        <p class="sw-hero__status" role="status">
          Signed in as a wholesale buyer
          {%- if customer.current_company %} for {{ customer.current_company.name | escape }}{% endif -%}
          . Catalog pricing applies in cart and checkout.
        </p>
      {%- endif -%}
    </div>

    {%- capture hero_points -%}
      {%- for i in (1..3) -%}
        {%- assign point_title_key = 'point_' | append: i | append: '_title' -%}
        {%- assign point_text_key = 'point_' | append: i | append: '_text' -%}
        {%- assign point_title = section.settings[point_title_key] -%}
        {%- if point_title != blank -%}
          <li>
            <strong>{{ point_title | escape }}</strong>
            {%- if section.settings[point_text_key] != blank -%}
              <span>{{ section.settings[point_text_key] | escape }}</span>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if hero_points != blank -%}
      <div class="sw-hero__bottom sh-shell">
        <ul class="sw-hero__points" role="list">
          {{- hero_points -}}
        </ul>
      </div>
    {%- endif -%}
  </section>

  <section class="sh-home sw-program sh-shell">
    <article class="sw-program__item">
      <p class="sh-eyebrow"><span>01</span> Who it is for</p>
      <h2>{{ section.settings.who_heading | escape }}</h2>
      <div class="sw-program__body">{{ section.settings.who_text }}</div>
    </article>
    <article class="sw-program__item">
      <p class="sh-eyebrow"><span>02</span> After approval</p>
      <h2>{{ section.settings.after_heading | escape }}</h2>
      <div class="sw-program__body">{{ section.settings.after_text }}</div>
    </article>
  </section>

  <section class="sw-request" id="WholesaleRequest" aria-labelledby="WholesaleRequestTitle-{{ section.id }}">
    <div class="sw-request__inner sh-shell">
      <div class="sh-home sw-request__intro">
        <p class="sh-eyebrow"><span>03</span> Request access</p>
        <h2 id="WholesaleRequestTitle-{{ section.id }}">{{ section.settings.form_heading | escape }}</h2>
        {%- if section.settings.form_text != blank -%}
          <p class="sw-request__text">{{ section.settings.form_text | escape }}</p>
        {%- endif -%}
      </div>

      <div class="sw-request__panel">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="sw-request__app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- when 'richtext' -%}
              <div class="rte sw-request__note" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
          {%- endcase -%}
        {%- endfor -%}
        {%- if section.blocks.size == 0 -%}
          <div class="sw-request__fallback">
            <p>
              Email
              <a href="mailto:{{ support_email | escape }}">{{ support_email | escape }}</a>
              with your shop name, location, and what you stock. We review every request before activating a company
              account.
            </p>
            <p>Signing in alone does not grant wholesale pricing — your company association does.</p>
          </div>
        {%- endif -%}
      </div>

      <dl class="sw-request__meta">
        {%- unless customer -%}
          <div>
            <dt>Already approved?</dt>
            <dd>
              <a class="sh-text-link" href="{{ login_url }}">
                {{- section.settings.login_label | default: 'Dealer sign in' | escape -}}
                <span aria-hidden="true">&nbsp;→</span>
              </a>
              <small>Use the email on your company profile.</small>
            </dd>
          </div>
        {%- endunless -%}
        {%- if support_email != blank -%}
          <div>
            <dt>Questions</dt>
            <dd>
              <a class="sw-request__email" href="mailto:{{ support_email | escape }}">{{ support_email | escape }}</a>
            </dd>
          </div>
        {%- endif -%}
      </dl>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "t:sections.wholesale_landing.name",
  "tag": "section",
  "class": "section wholesale-landing-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "t:sections.wholesale_landing.settings.hero_image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.wholesale_landing.settings.eyebrow",
      "default": "Spawn Fly Fish / Wholesale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.wholesale_landing.settings.heading",
      "default": "From our bench to your shop."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:sections.wholesale_landing.settings.lede",
      "default": "Dealer pricing, pack quantities, and a straight path to restock Spawn flies and tying materials. Built for fly shops, guides, and outfitters."
    },
    {
      "type": "text",
      "id": "request_label",
      "label": "t:sections.wholesale_landing.settings.request_label",
      "default": "Request wholesale access"
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "t:sections.wholesale_landing.settings.login_label",
      "default": "Dealer sign in"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "t:sections.wholesale_landing.settings.shop_label",
      "default": "Start ordering"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "t:sections.wholesale_landing.settings.account_label",
      "default": "Your account"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "t:sections.wholesale_landing.settings.shop_link"
    },
    {
      "type": "header",
      "content": "t:sections.wholesale_landing.settings.points_header"
    },
    {
      "type": "text",
      "id": "point_1_title",
      "label": "t:sections.wholesale_landing.settings.point_1_title",
      "default": "Dealer pricing"
    },
    {
      "type": "text",
      "id": "point_1_text",
      "label": "t:sections.wholesale_landing.settings.point_1_text",
      "default": "Applied in cart and checkout"
    },
    {
      "type": "text",
      "id": "point_2_title",
      "label": "t:sections.wholesale_landing.settings.point_2_title",
      "default": "Pack quantities"
    },
    {
      "type": "text",
      "id": "point_2_text",
      "label": "t:sections.wholesale_landing.settings.point_2_text",
      "default": "Built for restocking the wall"
    },
    {
      "type": "text",
      "id": "point_3_title",
      "label": "t:sections.wholesale_landing.settings.point_3_title",
      "default": "Reviewed by hand"
    },
    {
      "type": "text",
      "id": "point_3_text",
      "label": "t:sections.wholesale_landing.settings.point_3_text",
      "default": "Every request, from Ilwaco"
    },
    {
      "type": "header",
      "content": "t:sections.wholesale_landing.settings.who_header"
    },
    {
      "type": "text",
      "id": "who_heading",
      "label": "t:sections.wholesale_landing.settings.who_heading",
      "default": "Who this is for"
    },
    {
      "type": "richtext",
      "id": "who_text",
      "label": "t:sections.wholesale_landing.settings.who_text",
      "default": "<p>Independent fly shops, guides, and retailers stocking Spawn flies and materials. We review every request before activating a company account.</p><ul><li>Brick-and-mortar and specialty online dealers</li><li>Guides and outfitters buying for clients</li><li>Accounts that need pack quantities and net terms when offered</li></ul>"
    },
    {
      "type": "header",
      "content": "t:sections.wholesale_landing.settings.after_header"
    },
    {
      "type": "text",
      "id": "after_heading",
      "label": "t:sections.wholesale_landing.settings.after_heading",
      "default": "After you are approved"
    },
    {
      "type": "richtext",
      "id": "after_text",
      "label": "t:sections.wholesale_landing.settings.after_text",
      "default": "<p>Sign in with customer accounts. Your company association unlocks catalog pricing, quantity rules, and reorder tools. The public login link never grants wholesale access by itself.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.wholesale_landing.settings.form_header"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "t:sections.wholesale_landing.settings.form_heading",
      "default": "Request a dealer account"
    },
    {
      "type": "textarea",
      "id": "form_text",
      "label": "t:sections.wholesale_landing.settings.form_text",
      "default": "Tell us about your shop and what you stock. We review every request by hand and follow up once your company account is ready."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "t:sections.wholesale_landing.settings.support_email",
      "default": "info@spawnflyfish.com"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "richtext",
      "name": "t:sections.wholesale_landing.blocks.richtext.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.wholesale_landing.blocks.richtext.settings.text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.wholesale_landing.name"
    }
  ]
}
{% endschema %}
