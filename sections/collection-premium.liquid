{%- comment -%}
  spawn-merch-bot fly-library-traffic PREVIEW 2026-09-15: optional Fly Library CTA + page-link chips.
  Cite/Archive HOLD. Do not wipe Pick/Match/FAQ.
{%- endcomment -%}
{{ 'section-collection-premium.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'spawn-collection-sort.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'spawn-collection-sort.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign hero_variant = 'auto'
  assign hero_basic_path = false
  if template.suffix == blank or template.suffix == 'basic-collection'
    assign hero_basic_path = true
  endif
  if template.suffix == 'hero-wash'
    assign hero_variant = 'wash'
  elsif template.suffix == 'hero-split'
    assign hero_variant = 'split'
  endif
  assign hero_image = collection.metafields.custom.collection_hero_image.value
  assign hero_image_source = 'metafield'
  if hero_image == blank
    assign hero_image = collection.image
    assign hero_image_source = 'collection'
  endif
  if hero_basic_path
    assign hero_image = blank
    assign hero_image_source = 'none'
    assign hero_candidate = collection.metafields.custom.collection_hero_image.value
    if hero_candidate != blank and hero_candidate.width >= 800 and hero_candidate.aspect_ratio >= 1.2
      assign hero_image = hero_candidate
      assign hero_image_source = 'metafield'
    else
      assign hero_candidate = collection.image
      if hero_candidate != blank and hero_candidate.width >= 800 and hero_candidate.aspect_ratio >= 1.2
        assign hero_image = hero_candidate
        assign hero_image_source = 'collection'
      endif
    endif
    if hero_image != blank
      assign hero_variant = 'wash'
    else
      assign hero_variant = 'split'
    endif
  endif
  if template.suffix == 'hero-wash' and hero_image == blank
    for hero_product in collection.products
      assign hero_image = hero_product.featured_media.preview_image | default: hero_product.featured_image
      if hero_image != blank
        assign hero_image_source = 'product'
        break
      endif
    endfor
  endif
  assign aisle_body_html = collection.description
  assign show_about_aisle = false
  assign hero_from_admin_body = false
  assign hero_from_override = false
  assign compact_aisle_enabled = false
  if collection.handle == 'fly-tying-kits' or collection.handle == 'spawn-fly-heads-beads-eyes'
    assign compact_aisle_enabled = true
  endif
  assign hero_description = collection.metafields.custom.collection_description.value
  if hero_description == blank
    assign hero_description = section.settings.subtitle | strip
  endif
  if hero_description != blank
    assign hero_from_override = true
  endif
  if hero_description == blank
    assign desc_plain = collection.description | strip_html | strip
    if desc_plain != blank and desc_plain != collection.title
      assign hero_description = desc_plain
      assign hero_from_admin_body = true
    endif
  endif
  if hero_description == blank
    assign hero_description = page_description
  endif
  assign hero_description = hero_description | strip_html | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | strip
  if compact_aisle_enabled
    assign aisle_body_plain = aisle_body_html | strip_html | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | strip
    if hero_from_admin_body and hero_description.size > 280
      assign show_about_aisle = true
      assign compact_hero = blank
      if aisle_body_html contains '</p>'
        assign aisle_paragraphs = aisle_body_html | split: '</p>'
        for aisle_paragraph in aisle_paragraphs
          assign paragraph_plain = aisle_paragraph | strip_html | replace: '&amp;', '&' | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: '&quot;', '"' | replace: '&#39;', "'" | strip
          if paragraph_plain != blank
            assign compact_hero = paragraph_plain
            break
          endif
        endfor
      endif
      if compact_hero == blank or compact_hero.size > 280
        assign compact_hero = hero_description | truncatewords: 42, "" | strip
      endif
      assign hero_description = compact_hero
    elsif hero_from_override and aisle_body_plain.size > 280 and aisle_body_plain != hero_description
      assign show_about_aisle = true
    endif
  endif
  assign overlay_opacity = section.settings.overlay_opacity | default: 45
  assign overlay_strength = overlay_opacity | divided_by: 100.0
  assign hero_text_only = false
  if hero_image == blank and hero_variant == 'auto'
    assign hero_text_only = true
  endif
  if hero_variant == 'split'
    assign hero_text_only = true
    for hero_product in collection.products
      assign tile_image = hero_product.featured_media.preview_image | default: hero_product.featured_image
      if tile_image != blank
        assign hero_text_only = false
        break
      endif
    endfor
  endif
-%}

{%- style -%}
  #CollectionPremium-{{ section.id }} {
    --cp-overlay-strength: {{ overlay_strength }};
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="CollectionPremium-{{ section.id }}"
  class="collection-premium section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
  data-cp-root
>
  <div class="collection-premium__hero{% if hero_text_only %} collection-premium__hero--text-only{% endif %}{% unless hero_variant == 'auto' or hero_text_only %} collection-premium__hero--{{ hero_variant }}{% endunless %}"{% if hero_image != blank and hero_variant == 'auto' %} data-header-overlay{% endif %} data-cp-hero-variant="{{ hero_variant }}">
    {%- if hero_image != blank and hero_variant != 'split' -%}
      <div class="collection-premium__hero-media" aria-hidden="true" data-cp-image-source="{{ hero_image_source }}">
        {{
          hero_image
          | image_url: width: 3840
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
            alt: ''
        }}
      </div>
    {%- endif -%}
    <div class="collection-premium__hero-overlay" aria-hidden="true"></div>

    <nav class="collection-premium__breadcrumb" aria-label="Breadcrumb">
      <ol class="collection-premium__breadcrumb-list">
        <li class="collection-premium__breadcrumb-item">
          <a class="collection-premium__breadcrumb-link" href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t: default: 'Home' }}</a>
          <span class="collection-premium__breadcrumb-sep" aria-hidden="true">/</span>
        </li>
        <li class="collection-premium__breadcrumb-item">
          <span class="collection-premium__breadcrumb-current" aria-current="page">{{ collection.title | escape }}</span>
        </li>
      </ol>
    </nav>

    <div class="collection-premium__hero-inner">
      <div class="collection-premium__hero-copy">
      <p class="collection-premium__eyebrow">Collection</p>
      <h1 class="collection-premium__title">{{ collection.title | escape }}</h1>
      {%- if hero_description != blank -%}
        <div class="collection-premium__subtitle">
          <p>{{ hero_description | escape }}</p>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="collection-premium__chips" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'chip' -%}
              {%- assign chip_collection = block.settings.collection -%}
              {%- assign chip_label = block.settings.label | strip -%}
              {%- assign chip_url = block.settings.link -%}
              {%- if chip_url == blank -%}
                {%- assign chip_url = chip_collection.url -%}
              {%- endif -%}
              {%- if chip_url == blank -%}
                {%- if chip_label == 'Fly Library' -%}
                  {%- assign chip_url = pages['fly-library'].url -%}
                {%- elsif chip_label == 'Intruder recipe' -%}
                  {%- assign chip_url = pages['fly-library-sea-run-cutthroat-intruder'].url -%}
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.link == blank and chip_collection.handle == 'fly-tying-tools' and chip_collection != blank -%}
                {%- assign chip_url = chip_collection.url | append: '?view=fly-tying-tools' -%}
              {%- endif -%}
              {%- if chip_label == blank and chip_collection != blank -%}
                {%- assign chip_label = chip_collection.title -%}
              {%- endif -%}
              {%- if chip_label != blank -%}
                <li {{ block.shopify_attributes }}>
                  {%- if chip_url != blank -%}
                    <a class="collection-premium__chip" href="{{ chip_url }}">{{ chip_label | escape }}</a>
                  {%- else -%}
                    <span class="collection-premium__chip" aria-disabled="true">{{ chip_label | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- liquid
          assign fl_cta_label = section.settings.fly_library_cta_label
          assign fl_cta_url = section.settings.fly_library_cta_link
          assign fl_sec_label = section.settings.fly_library_secondary_label
          assign fl_sec_url = section.settings.fly_library_secondary_link
          if fl_cta_label == blank
            if collection.handle == 'fly-tying-shanks' or collection.handle == 'feathers' or collection.handle == 'fly-tying-materials'
              assign fl_cta_label = 'Fly Library: shoppable recipes from our tying videos'
            endif
          endif
          if fl_cta_url == blank
            assign fl_cta_url = pages['fly-library'].url
          endif
          if fl_sec_label == blank and collection.handle == 'fly-tying-shanks'
            assign fl_sec_label = 'Intruder recipe'
            assign fl_sec_url = pages['fly-library-sea-run-cutthroat-intruder'].url
          endif
        -%}
        {%- if fl_cta_label != blank -%}
          <p class="collection-premium__library-cta">
            <a href="{{ fl_cta_url }}">{{ fl_cta_label | escape }}</a>
            {%- if fl_sec_label != blank and fl_sec_url != blank -%}
              <span class="collection-premium__library-cta-sep" aria-hidden="true">·</span>
              <a href="{{ fl_sec_url }}">{{ fl_sec_label | escape }}</a>
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endif -%}
      </div>
      {%- if hero_variant == 'split' and hero_text_only == false -%}
        <ul class="collection-premium__hero-tiles" role="list" aria-label="Products from {{ collection.title | escape }}">
          {%- assign hero_tile_count = 0 -%}
          {%- for hero_product in collection.products -%}
            {%- assign tile_image = hero_product.featured_media.preview_image | default: hero_product.featured_image -%}
            {%- if tile_image != blank -%}
              <li class="collection-premium__hero-tile">
                <a class="collection-premium__hero-tile-link" href="{{ hero_product.url }}">
                  <div class="collection-premium__hero-tile-image">
                    {{ tile_image | image_url: width: 560 | image_tag: loading: 'eager', widths: '180, 280, 420, 560', sizes: '(min-width: 990px) 15vw, 30vw', alt: '' }}
                  </div>
                  <span class="collection-premium__hero-tile-title">{{ hero_product.title | escape }}</span>
                  <span class="collection-premium__hero-tile-price">{% if hero_product.price_varies %}From {% endif %}{{ hero_product.price | money }}</span>
                </a>
              </li>
              {%- assign hero_tile_count = hero_tile_count | plus: 1 -%}
              {%- if hero_tile_count == 3 -%}{%- break -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="collection-premium__catalog">
    <div class="collection-premium__catalog-inner">
      {%- paginate collection.products by section.settings.products_per_page -%}

        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <div class="collection-premium__toolbar" id="main-collection-filters" data-id="{{ section.id }}">
            <div class="collection-premium__toolbar-left">
              {%- if section.settings.enable_filtering -%}
                <button
                  type="button"
                  class="collection-premium__filters-toggle"
                  data-cp-filters-toggle
                  aria-expanded="false"
                  aria-controls="CollectionPremiumFilters-{{ section.id }}"
                >
                  <span class="collection-premium__filters-toggle-label" data-cp-filters-label>Show filters</span>
                </button>
              {%- endif -%}

              <div class="product-count light collection-premium__count" role="status">
                <span id="ProductCountDesktop">
                  {%- if collection.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count }}
                  {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: collection.products_count, count: collection.all_products_count
                    }}
                  {%- endif -%}
                </span>
                <span class="hidden" id="ProductCount">
                  {%- if collection.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count }}
                  {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: collection.products_count, count: collection.all_products_count
                    }}
                  {%- endif -%}
                </span>
              </div>
            </div>

            {%- if section.settings.enable_sorting -%}
              <facet-filters-form class="collection-premium__sort facets">
                <form class="collection-premium__sort-form facets-vertical-form" id="FacetSortForm">
                  <div class="facet-filters sorting collection-premium__sort-field">
                    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                    <spawn-collection-sort class="cp-sort" id="CollectionSort-{{ section.id }}">
                    <div class="cp-sort__native">
                    <label class="collection-premium__sort-label" for="SortBy">
                      {{ 'products.facets.sort_by_label' | t }}
                    </label>
                    <div class="select collection-premium__sort-select">
                      <select
                        name="sort_by"
                        class="facet-filters__sort select__select collection-premium__sort-control"
                        id="SortBy"
                        aria-describedby="a11y-refresh-page-message"
                      >
                        {%- for option in collection.sort_options -%}
                          {%- if option.value == sort_by -%}{%- assign selected_sort_name = option.name -%}{%- endif -%}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}
                              selected="selected"
                            {% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                      <span class="svg-wrapper">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </div>
                    </div>
                    <button
                      class="cp-sort__trigger"
                      type="button"
                      role="combobox"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-controls="CollectionSortList-{{ section.id }}"
                      aria-labelledby="CollectionSortLabel-{{ section.id }} CollectionSortValue-{{ section.id }}"
                      aria-describedby="a11y-refresh-page-message"
                      hidden
                    >
                      <span class="cp-sort__label" id="CollectionSortLabel-{{ section.id }}">{{ 'products.facets.sort_by_label' | t | remove: ':' }}</span>
                      <span class="cp-sort__value" id="CollectionSortValue-{{ section.id }}">{{ selected_sort_name | escape }}</span>
                      <span class="cp-sort__caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
                    </button>
                    <ul
                      class="cp-sort__list"
                      id="CollectionSortList-{{ section.id }}"
                      role="listbox"
                      aria-labelledby="CollectionSortLabel-{{ section.id }}"
                      hidden
                    >
                      {%- for option in collection.sort_options -%}
                        <li
                          class="cp-sort__option"
                          id="CollectionSortOption-{{ section.id }}-{{ forloop.index0 }}"
                          role="option"
                          aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}"
                          data-value="{{ option.value | escape }}"
                        >
                          <span>{{ option.name | escape }}</span>
                          <span class="cp-sort__check" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
                        </li>
                      {%- endfor -%}
                    </ul>
                    </spawn-collection-sort>
                  </div>
                </form>
              </facet-filters-form>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="collection-premium__body">
          {%- if section.settings.enable_filtering -%}
            <aside
              id="CollectionPremiumFilters-{{ section.id }}"
              class="collection-premium__filters facets-wrapper"
              aria-labelledby="verticalTitle"
              data-cp-filters-panel
              hidden
            >
              <div class="collection-premium__filters-head">
                <h2 class="collection-premium__filters-title" id="verticalTitle">Filters</h2>
                <button
                  type="button"
                  class="collection-premium__filters-close"
                  data-cp-filters-toggle
                  aria-label="Hide filters"
                >
                  Hide filters
                </button>
              </div>
              {% render 'facets',
                results: collection,
                enable_filtering: true,
                enable_sorting: false,
                filter_type: 'vertical',
                paginate: paginate
              %}
            </aside>
            <div class="collection-premium__filters-backdrop" data-cp-filters-backdrop hidden></div>
          {%- endif -%}
          <div
            class="product-grid-container collection-premium__grid{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            id="ProductGridContainer"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- if collection.products.size == 0 -%}
              <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
                <div class="loading-overlay gradient"></div>
                <div class="title-wrapper center">
                  <h2 class="title title--primary">
                    {{ 'sections.collection_template.empty' | t -}}
                    <br>
                    {{
                      'sections.collection_template.use_fewer_filters_html'
                      | t: link: collection.url, class: 'underlined-link link'
                    }}
                  </h2>
                </div>
              </div>
            {%- else -%}
              <div class="collection">
                <div class="loading-overlay gradient"></div>
                <ul
                  id="product-grid"
                  data-id="{{ section.id }}"
                  class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                >
                  {%- for product in collection.products -%}
                    {% assign lazy_load = false %}
                    {%- if forloop.index > 2 -%}
                      {%- assign lazy_load = true -%}
                    {%- endif -%}
                    <li
                      class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% render 'card-product-premium',
                        card_product: product,
                        media_aspect_ratio: section.settings.image_ratio,
                        show_rating: true,
                        lazy_load: lazy_load,
                        section_id: section.id
                      %}
                    </li>
                  {%- endfor -%}
                </ul>

                {%- if paginate.pages > 1 -%}
                  {% render 'pagination', paginate: paginate, anchor: '' %}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

        </div>
      {%- endpaginate -%}
    </div>
  </div>
  {%- if show_about_aisle and aisle_body_html != blank -%}
    <div class="collection-premium__about-aisle page-width">
      <details class="collection-premium__about-aisle-details">
        <summary>About this aisle</summary>
        <div class="rte collection-premium__about-aisle-body">
          {{ aisle_body_html }}
        </div>
      </details>
    </div>
  {%- endif -%}

{%- comment -%} spawn-merch-bot 2026-09-26 tools/tails drop Buying Guide band when zero Admin cards remain after filter (lead alone is useless) {%- endcomment -%}
{%- if section.settings.show_admin_description and collection.description != blank -%}
  {%- assign admin_chunks = collection.description | split: '<h2' -%}
  {%- capture admin_cards_html -%}
    {%- for chunk in admin_chunks -%}
      {%- unless forloop.first -%}
        {%- assign h2_parts = chunk | split: '</h2>' -%}
        {%- assign h2_head = h2_parts | first -%}
        {%- if h2_parts.size > 1 -%}
          {%- assign h2_body = h2_parts[1] -%}
        {%- else -%}
          {%- assign h2_body = '' -%}
        {%- endif -%}
        {%- assign title_raw = h2_head | split: '>' | last -%}
        {%- assign title = title_raw | strip_html | strip -%}
        {%- assign title_key = title | downcase -%}
        {%- assign skip_card = false -%}
        {%- if title_key == 'faq' or title_key contains 'faq' -%}
          {%- assign skip_card = true -%}
        {%- endif -%}
        {%- comment -%} Skip howto-overlap / aisle-map H2 cards: tying-guide + FAQ own those topics. {%- endcomment -%}
        {%- if title_key == 'the four essentials' -%}{%- assign skip_card = true -%}{%- endif -%}
        {%- if title_key == 'whip finishers on this aisle' -%}{%- assign skip_card = true -%}{%- endif -%}
        {%- if title_key == 'specialty tools worth adding later' -%}{%- assign skip_card = true -%}{%- endif -%}
        {%- if title_key == 'synthetic vs natural tails' -%}{%- assign skip_card = true -%}{%- endif -%}
        {%- if title_key == 'what else sits on this aisle' -%}{%- assign skip_card = true -%}{%- endif -%}
        {%- unless skip_card -%}
          {%- if title != blank or h2_body != blank -%}
            <article class="collection-premium__admin-card">
              {%- if title != blank -%}
                <h2 class="collection-premium__admin-card-title">{{ title | escape }}</h2>
              {%- endif -%}
              {%- if h2_body != blank -%}
                <div class="rte collection-premium__admin-card-body">
                  {{ h2_body }}
                </div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endunless -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign admin_cards_html = admin_cards_html | strip -%}
  {%- if admin_cards_html != blank -%}
    {{ 'premium-collection-seo.css' | asset_url | stylesheet_tag }}
    <div class="collection-premium__admin-body premium-seo premium-seo--guide">
      <div class="page-width collection-premium__admin-body-shell">
        <p class="premium-seo__eyebrow">Buying guide</p>
        {%- assign admin_lead = admin_chunks.first | strip -%}
        {%- if admin_chunks.size > 1 and admin_lead != blank -%}
          <div class="collection-premium__admin-lead rte">
            {{ admin_lead }}
          </div>
        {%- endif -%}
        <div class="collection-premium__admin-grid">
          {{ admin_cards_html }}
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
</section>


<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumbs.home' | t: default: 'Home' | json }},
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ request.origin | append: collection.url | json }}
      }
    ]
  }
</script>

