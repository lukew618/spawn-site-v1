{{ 'section-collection-premium.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'spawn-collection-sort.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'spawn-collection-sort.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign hero_image = collection.metafields.custom.collection_hero_image.value
  if hero_image == blank
    assign hero_image = collection.image
  endif
  assign hero_description = collection.metafields.custom.collection_description.value
  if hero_description == blank
    assign hero_description = section.settings.subtitle
  endif
  assign overlay_opacity = section.settings.overlay_opacity | default: 45
  assign overlay_strength = overlay_opacity | divided_by: 100.0
-%}

{%- style -%}
  #CollectionPremium-{{ section.id }} {
    --cp-overlay-strength: {{ overlay_strength }};
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="CollectionPremium-{{ section.id }}"
  class="collection-premium section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
  data-cp-root
>
  <div class="collection-premium__hero"{% if hero_image != blank %} data-header-overlay{% endif %}>
    {%- if hero_image != blank -%}
      <div class="collection-premium__hero-media" aria-hidden="true">
        {{
          hero_image
          | image_url: width: 3840
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
            alt: ''
        }}
      </div>
    {%- endif -%}
    <div class="collection-premium__hero-overlay" aria-hidden="true"></div>

    <nav class="collection-premium__breadcrumb" aria-label="Breadcrumb">
      <ol class="collection-premium__breadcrumb-list">
        <li class="collection-premium__breadcrumb-item">
          <a class="collection-premium__breadcrumb-link" href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t: default: 'Home' }}</a>
          <span class="collection-premium__breadcrumb-sep" aria-hidden="true">/</span>
        </li>
        <li class="collection-premium__breadcrumb-item">
          <span class="collection-premium__breadcrumb-current" aria-current="page">{{ collection.title | escape }}</span>
        </li>
      </ol>
    </nav>

    <div class="collection-premium__hero-inner">
      <p class="collection-premium__eyebrow">Collection</p>
      <h1 class="collection-premium__title">{{ collection.title | escape }}</h1>
      {%- if hero_description != blank -%}
        <div class="collection-premium__subtitle">
          <p>{{ hero_description | escape }}</p>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="collection-premium__chips" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'chip' -%}
              {%- assign chip_collection = block.settings.collection -%}
              {%- assign chip_label = block.settings.label | strip -%}
              {%- if chip_label == blank and chip_collection != blank -%}
                {%- assign chip_label = chip_collection.title -%}
              {%- endif -%}
              {%- if chip_label != blank -%}
                <li {{ block.shopify_attributes }}>
                  {%- if chip_collection != blank -%}
                    <a class="collection-premium__chip" href="{{ chip_collection.url }}">{{ chip_label | escape }}</a>
                  {%- else -%}
                    <span class="collection-premium__chip" aria-disabled="true">{{ chip_label | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="collection-premium__catalog">
    <div class="collection-premium__catalog-inner">
      {%- paginate collection.products by section.settings.products_per_page -%}

        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <div class="collection-premium__toolbar" id="main-collection-filters" data-id="{{ section.id }}">
            <div class="collection-premium__toolbar-left">
              {%- if section.settings.enable_filtering -%}
                <button
                  type="button"
                  class="collection-premium__filters-toggle"
                  data-cp-filters-toggle
                  aria-expanded="false"
                  aria-controls="CollectionPremiumFilters-{{ section.id }}"
                >
                  <span class="collection-premium__filters-toggle-label" data-cp-filters-label>Show filters</span>
                </button>
              {%- endif -%}

              <div class="product-count light collection-premium__count" role="status">
                <span id="ProductCountDesktop">
                  {%- if collection.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count }}
                  {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: collection.products_count, count: collection.all_products_count
                    }}
                  {%- endif -%}
                </span>
                <span class="hidden" id="ProductCount">
                  {%- if collection.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: collection.terms, count: collection.results_count }}
                  {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: collection.products_count, count: collection.all_products_count
                    }}
                  {%- endif -%}
                </span>
              </div>
            </div>

            {%- if section.settings.enable_sorting -%}
              <facet-filters-form class="collection-premium__sort facets">
                <form class="collection-premium__sort-form facets-vertical-form" id="FacetSortForm">
                  <div class="facet-filters sorting collection-premium__sort-field">
                    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                    <spawn-collection-sort class="cp-sort" id="CollectionSort-{{ section.id }}">
                    <div class="cp-sort__native">
                    <label class="collection-premium__sort-label" for="SortBy">
                      {{ 'products.facets.sort_by_label' | t }}
                    </label>
                    <div class="select collection-premium__sort-select">
                      <select
                        name="sort_by"
                        class="facet-filters__sort select__select collection-premium__sort-control"
                        id="SortBy"
                        aria-describedby="a11y-refresh-page-message"
                      >
                        {%- for option in collection.sort_options -%}
                          {%- if option.value == sort_by -%}{%- assign selected_sort_name = option.name -%}{%- endif -%}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}
                              selected="selected"
                            {% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                      <span class="svg-wrapper">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </div>
                    </div>
                    <button
                      class="cp-sort__trigger"
                      type="button"
                      role="combobox"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-controls="CollectionSortList-{{ section.id }}"
                      aria-labelledby="CollectionSortLabel-{{ section.id }} CollectionSortValue-{{ section.id }}"
                      aria-describedby="a11y-refresh-page-message"
                      hidden
                    >
                      <span class="cp-sort__label" id="CollectionSortLabel-{{ section.id }}">{{ 'products.facets.sort_by_label' | t | remove: ':' }}</span>
                      <span class="cp-sort__value" id="CollectionSortValue-{{ section.id }}">{{ selected_sort_name | escape }}</span>
                      <span class="cp-sort__caret" aria-hidden="true">{{ 'icon-caret.svg' | inline_asset_content }}</span>
                    </button>
                    <ul
                      class="cp-sort__list"
                      id="CollectionSortList-{{ section.id }}"
                      role="listbox"
                      aria-labelledby="CollectionSortLabel-{{ section.id }}"
                      hidden
                    >
                      {%- for option in collection.sort_options -%}
                        <li
                          class="cp-sort__option"
                          id="CollectionSortOption-{{ section.id }}-{{ forloop.index0 }}"
                          role="option"
                          aria-selected="{% if option.value == sort_by %}true{% else %}false{% endif %}"
                          data-value="{{ option.value | escape }}"
                        >
                          <span>{{ option.name | escape }}</span>
                          <span class="cp-sort__check" aria-hidden="true">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
                        </li>
                      {%- endfor -%}
                    </ul>
                    </spawn-collection-sort>
                  </div>
                </form>
              </facet-filters-form>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="collection-premium__body">
          {%- if section.settings.enable_filtering -%}
            <aside
              id="CollectionPremiumFilters-{{ section.id }}"
              class="collection-premium__filters facets-wrapper"
              aria-labelledby="verticalTitle"
              data-cp-filters-panel
              hidden
            >
              <div class="collection-premium__filters-head">
                <h2 class="collection-premium__filters-title" id="verticalTitle">Filters</h2>
                <button
                  type="button"
                  class="collection-premium__filters-close"
                  data-cp-filters-toggle
                  aria-label="Hide filters"
                >
                  Hide filters
                </button>
              </div>
              {% render 'facets',
                results: collection,
                enable_filtering: true,
                enable_sorting: false,
                filter_type: 'vertical',
                paginate: paginate
              %}
            </aside>
            <div class="collection-premium__filters-backdrop" data-cp-filters-backdrop hidden></div>
          {%- endif -%}
          <div
            class="product-grid-container collection-premium__grid{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            id="ProductGridContainer"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- if collection.products.size == 0 -%}
              <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
                <div class="loading-overlay gradient"></div>
                <div class="title-wrapper center">
                  <h2 class="title title--primary">
                    {{ 'sections.collection_template.empty' | t -}}
                    <br>
                    {{
                      'sections.collection_template.use_fewer_filters_html'
                      | t: link: collection.url, class: 'underlined-link link'
                    }}
                  </h2>
                </div>
              </div>
            {%- else -%}
              <div class="collection">
                <div class="loading-overlay gradient"></div>
                <ul
                  id="product-grid"
                  data-id="{{ section.id }}"
                  class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                >
                  {%- for product in collection.products -%}
                    {% assign lazy_load = false %}
                    {%- if forloop.index > 2 -%}
                      {%- assign lazy_load = true -%}
                    {%- endif -%}
                    <li
                      class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% render 'card-product-premium',
                        card_product: product,
                        media_aspect_ratio: section.settings.image_ratio,
                        show_rating: true,
                        lazy_load: lazy_load,
                        section_id: section.id
                      %}
                    </li>
                  {%- endfor -%}
                </ul>

                {%- if paginate.pages > 1 -%}
                  {% render 'pagination', paginate: paginate, anchor: '' %}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

        </div>
      {%- endpaginate -%}
    </div>
  </div>
</section>


<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumbs.home' | t: default: 'Home' | json }},
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }}
      }
    ]
  }
</script>

<script>
  (function () {
    var root = document.querySelector('#CollectionPremium-{{ section.id }}');
    if (!root) return;
    var mobileMq = window.matchMedia('(max-width: 989px)');

    function setFiltersOpen(open) {
      root.classList.toggle('is-filters-open', open);
      var panel = root.querySelector('[data-cp-filters-panel]');
      var backdrop = root.querySelector('[data-cp-filters-backdrop]');
      var toggles = root.querySelectorAll('[data-cp-filters-toggle]');
      var label = root.querySelector('[data-cp-filters-label]');
      if (panel) {
        if (open) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      }
      if (backdrop) {
        if (open) backdrop.removeAttribute('hidden');
        else backdrop.setAttribute('hidden', '');
      }
      toggles.forEach(function (btn) {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      if (label) label.textContent = open ? 'Hide filters' : 'Show filters';
      document.documentElement.classList.toggle('cp-filters-lock', open && mobileMq.matches);
    }

    mobileMq.addEventListener('change', function () {
      document.documentElement.classList.toggle(
        'cp-filters-lock',
        root.classList.contains('is-filters-open') && mobileMq.matches
      );
    });

    root.addEventListener('click', function (event) {
      var toggle = event.target.closest('[data-cp-filters-toggle], [data-cp-filters-backdrop]');
      if (toggle && root.contains(toggle)) {
        event.preventDefault();
        setFiltersOpen(!root.classList.contains('is-filters-open'));
        return;
      }

      var thumb = event.target.closest('[data-cp-thumb]');
      if (!thumb || !root.contains(thumb)) return;
      event.preventDefault();
      var card = thumb.closest('[data-cp-card]');
      if (!card) return;
      var main = card.querySelector('[data-cp-main]');
      if (!main) return;
      var src = thumb.getAttribute('data-src');
      var srcset = thumb.getAttribute('data-srcset');
      var alt = thumb.getAttribute('data-alt');
      if (src) main.setAttribute('src', src);
      if (srcset) main.setAttribute('srcset', srcset);
      if (alt) main.setAttribute('alt', alt);
      card.querySelectorAll('[data-cp-thumb]').forEach(function (el) {
        el.classList.toggle('is-selected', el === thumb);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collection premium",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We stock what we tie with in Ilwaco. Feathers, beads, shanks, and tools.",
      "info": "Used when collection.metafields.custom.collection_description is empty."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Hero overlay opacity",
      "default": 45
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 36,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection premium",
      "blocks": []
    }
  ]
}
{% endschema %}
