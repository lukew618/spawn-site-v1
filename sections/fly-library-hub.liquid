{% comment %}
  spawn-merch-bot fly-library-hub MAIN 2026-09-15
  Compelling recipe card grid for /pages/fly-library.
  YouTube thumbs OK on cards; hero uses real Spawn Files image or none.
  Soft CollectionPage/ItemList JSON-LD. Cite/Archive HOLD. No Josh Slack.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #FlyLibraryHub-{{ section.id }} .flh-hero {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    #FlyLibraryHub-{{ section.id }} .flh-hero--with-image {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2.5rem;
    }
  }
  #FlyLibraryHub-{{ section.id }} .flh-hero__media {
    margin: 0;
    border-radius: var(--media-radius, 0.5rem);
    overflow: hidden;
    background: rgb(var(--color-background));
  }
  #FlyLibraryHub-{{ section.id }} .flh-hero__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  #FlyLibraryHub-{{ section.id }} .flh-eyebrow {
    margin: 0 0 0.6rem;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  #FlyLibraryHub-{{ section.id }} .flh-title {
    margin: 0 0 0.85rem;
  }
  #FlyLibraryHub-{{ section.id }} .flh-intro {
    margin: 0;
    max-width: 38rem;
    font-size: 1.6rem;
    line-height: 1.5;
  }
  #FlyLibraryHub-{{ section.id }} .flh-grid-heading {
    margin: 0 0 1.25rem;
  }
  #FlyLibraryHub-{{ section.id }} .flh-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media screen and (min-width: 750px) {
    #FlyLibraryHub-{{ section.id }} .flh-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: 1.75rem;
    }
  }
  #FlyLibraryHub-{{ section.id }} .flh-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    border-radius: var(--media-radius, 0.5rem);
    background: rgb(var(--color-background));
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card:hover {
    border-color: rgba(var(--color-foreground), 0.28);
    box-shadow: 0 10px 28px rgba(var(--color-foreground), 0.08);
    transform: translateY(-2px);
  }
  #FlyLibraryHub-{{ section.id }} .flh-card--soon {
    opacity: 0.72;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card--soon:hover {
    transform: none;
    box-shadow: none;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: rgba(var(--color-foreground), 0.04);
    overflow: hidden;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__media--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10rem;
    padding: 1.25rem;
    text-align: center;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.55);
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 1;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgba(var(--color-background), 0.92);
    border: 1px solid rgba(var(--color-foreground), 0.14);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.4rem;
    flex: 1;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__title {
    margin: 0;
    font-size: calc(var(--font-heading-scale) * 1.8rem);
    line-height: 1.25;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__hook {
    margin: 0;
    flex: 1;
    color: rgba(var(--color-foreground), 0.78);
    font-size: 1.4rem;
    line-height: 1.45;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__cta {
    margin-top: 0.35rem;
    align-self: flex-start;
  }
  #FlyLibraryHub-{{ section.id }} .flh-card__soon-label {
    margin-top: 0.35rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.55);
  }
  #FlyLibraryHub-{{ section.id }} a.flh-card__media-link {
    color: inherit;
    text-decoration: none;
  }
{%- endstyle -%}

<div
  id="FlyLibraryHub-{{ section.id }}"
  class="fly-library-hub color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {%- liquid
      assign has_hero_image = false
      if section.settings.hero_image != blank
        assign has_hero_image = true
      endif
    -%}

    <div class="flh-hero{% if has_hero_image %} flh-hero--with-image{% endif %}">
      <div class="flh-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="flh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="flh-title {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <div class="flh-intro rte">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>

      {%- if has_hero_image -%}
        {%- liquid
          assign hero_alt = section.settings.hero_image.alt
          if hero_alt == blank
            assign hero_alt = section.settings.heading
          endif
        -%}
        <figure class="flh-hero__media">
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              loading: 'eager',
              widths: '400, 600, 800, 1000, 1200, 1500, 1800',
              sizes: '(min-width: 750px) 45vw, 100vw',
              alt: hero_alt
          }}
        </figure>
      {%- endif -%}
    </div>

    {%- if section.settings.grid_heading != blank -%}
      <h2 class="flh-grid-heading {{ section.settings.grid_heading_size }}">{{ section.settings.grid_heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="flh-grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_soon = false
            if block.settings.status == 'coming_soon'
              assign is_soon = true
            endif

            assign thumb_url = blank
            assign thumb_alt = block.settings.title
            if block.settings.image != blank
              assign thumb_url = block.settings.image | image_url: width: 1200
              if block.settings.image.alt != blank
                assign thumb_alt = block.settings.image.alt
              endif
            elsif block.settings.youtube_id != blank
              assign yt_id = block.settings.youtube_id | strip
              assign thumb_url = 'https://i.ytimg.com/vi/' | append: yt_id | append: '/hqdefault.jpg'
            endif

            assign card_link = block.settings.link
            if is_soon
              assign card_link = blank
            endif
          -%}
          <li
            class="flh-card{% if is_soon %} flh-card--soon{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if thumb_url != blank -%}
              {%- if card_link != blank -%}
                <a class="flh-card__media flh-card__media-link" href="{{ card_link }}" aria-label="{{ block.settings.title | escape }}">
                  {%- if block.settings.badge != blank -%}
                    <span class="flh-card__badge">{{ block.settings.badge | escape }}</span>
                  {%- endif -%}
                  <img
                    src="{{ thumb_url | escape }}"
                    alt="{{ thumb_alt | escape }}"
                    width="480"
                    height="270"
                    loading="{% if forloop.index > 2 %}lazy{% else %}eager{% endif %}"
                  >
                </a>
              {%- else -%}
                <div class="flh-card__media">
                  {%- if block.settings.badge != blank -%}
                    <span class="flh-card__badge">{{ block.settings.badge | escape }}</span>
                  {%- endif -%}
                  <img
                    src="{{ thumb_url | escape }}"
                    alt="{{ thumb_alt | escape }}"
                    width="480"
                    height="270"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
            {%- else -%}
              <div class="flh-card__media flh-card__media--empty" aria-hidden="true">
                {%- if block.settings.badge != blank -%}
                  {{ block.settings.badge | escape }}
                {%- else -%}
                  Coming soon
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="flh-card__body">
              {%- if block.settings.title != blank -%}
                <h3 class="flh-card__title">
                  {%- if card_link != blank -%}
                    <a href="{{ card_link }}">{{ block.settings.title | escape }}</a>
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </h3>
              {%- endif -%}

              {%- if block.settings.hook != blank -%}
                <p class="flh-card__hook">{{ block.settings.hook | escape }}</p>
              {%- endif -%}

              {%- if is_soon -%}
                <p class="flh-card__soon-label">
                  {%- if block.settings.coming_soon_label != blank -%}
                    {{ block.settings.coming_soon_label | escape }}
                  {%- else -%}
                    Coming soon
                  {%- endif -%}
                </p>
              {%- elsif card_link != blank and block.settings.cta_label != blank -%}
                <a class="button button--primary flh-card__cta" href="{{ card_link }}">
                  {{ block.settings.cta_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>


{%- comment -%} Soft SEO: CollectionPage + ItemList of live recipe cards only {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ section.settings.heading | default: page.title | json }},
  "description": {{ section.settings.intro | strip_html | strip | json }},
  "url": {{ request.origin | append: page.url | json }},
  "isPartOf": {
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }}
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {%- assign flh_pos = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.status == 'live' and block.settings.title != blank -%}
          {%- assign flh_pos = flh_pos | plus: 1 -%}
          {%- if flh_pos > 1 -%},{%- endif -%}
          {
            "@type": "ListItem",
            "position": {{ flh_pos }},
            "name": {{ block.settings.title | json }}
            {%- if block.settings.link != blank -%}
            ,"url": {{ request.origin | append: block.settings.link | json }}
            {%- endif -%}
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  }
}
</script>

{% schema %}
{
  "name": "Fly library hub",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Real Spawn Files photo only. Leave blank for text-only intro."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Spawn Fly Library"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fly Library"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Ilwaco fly-tying recipes from the Spawn shop floor. Short, shoppable patterns with materials linked to our collections.</p>"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Grid heading",
      "default": "Recipes"
    },
    {
      "type": "select",
      "id": "grid_heading_size",
      "label": "Grid heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "Desktop columns"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "recipe_card",
      "name": "Recipe card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Recipe title"
        },
        {
          "type": "text",
          "id": "hook",
          "label": "Short hook",
          "default": "One-line reason to click."
        },
        {
          "type": "text",
          "id": "youtube_id",
          "label": "YouTube video ID",
          "info": "Builds https://i.ytimg.com/vi/ID/hqdefault.jpg. Leave blank for coming-soon cards with no image."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Override image",
          "info": "Optional real Spawn Files photo. Overrides YouTube thumb when set."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Recipe page link"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Watch recipe"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Status",
          "options": [
            { "value": "live", "label": "Live" },
            { "value": "coming_soon", "label": "Coming soon" }
          ],
          "default": "live"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Optional chip on the thumb (e.g. New or Coming soon)."
        },
        {
          "type": "text",
          "id": "coming_soon_label",
          "label": "Coming soon label",
          "default": "Coming week of Sep 21"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fly library hub",
      "blocks": [
        { "type": "recipe_card" },
        { "type": "recipe_card" }
      ]
    }
  ]
}
{% endschema %}
