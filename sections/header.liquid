{% render 'spawn-home-header', section: section %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "link_list",
      "id": "drawer_menu",
      "label": "Drawer menu (Shop categories)"
    }
  ]
}
{% endschema %}
